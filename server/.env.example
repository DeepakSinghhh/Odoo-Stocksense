PORT=4000
JWT_SECRET=change-me

# Password-reset emails (optional). Without either option the code is printed in the
# server console and shown on the reset screen (set OTP_FALLBACK=off to hide it).

# Option A — Brevo HTTPS API (works on Render's free plan, which blocks SMTP ports)
BREVO_API_KEY=
MAIL_FROM="StockSense <your-verified-sender@gmail.com>"

# Option B — classic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
